# Real Let's Encrypt cert for the sslip.io hostname derived from this box's
# public IP; reverse-proxy to the local manager over the host network. The
# frontend's toSecureHost() maps <ip>:9080 -> <dashed-ip>.sslip.io:9443, so no
# frontend change is needed per box. SSLIP_HOST comes from .env (gen-env.sh).
{$SSLIP_HOST}:9443 {
	reverse_proxy 127.0.0.1:9080
}
